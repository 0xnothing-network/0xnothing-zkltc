{
  "name": "0xnothing-zkltc",
  "version": "2.0.0",
  "private": true,
  "description": "0xPixel, 0xPump, and 0xFi workspace for the LitVM LiteForge testnet",
  "scripts": {
    "clean:generated": "node scripts/clean-generated.mjs",
    "clean:generated:dry": "node scripts/clean-generated.mjs --dry-run",
    "test:tooling": "node --test scripts/test/*.test.mjs",
    "dev": "npm --prefix 0xNothing-zkLTC-Testnet/apps/web run dev -- --port 3300",
    "dev:fi": "npm --prefix 0xNothing-zkLTC-Testnet/apps/web run dev -- --port 3300",
    "build:web": "npm --prefix 0xNothing-zkLTC-Testnet/apps/web run build",
    "lint:web": "npm --prefix 0xNothing-zkLTC-Testnet/apps/web run lint",
    "typecheck:web": "npm --prefix 0xNothing-zkLTC-Testnet/apps/web run typecheck",
    "test:web": "npm --prefix 0xNothing-zkLTC-Testnet/apps/web run test",
    "build:wallet": "npm --prefix 0xNothing-zkLTC-Testnet/apps/wallet run build",
    "typecheck:wallet": "npm --prefix 0xNothing-zkLTC-Testnet/apps/wallet run typecheck",
    "test:wallet": "npm --prefix 0xNothing-zkLTC-Testnet/apps/wallet run test",
    "verify:wallet": "npm run test:wallet && npm run typecheck:wallet && npm run build:wallet",
    "test:contracts": "npm run test:contracts:testnet",
    "test:contracts:testnet": "forge test --root 0xNothing-zkLTC-Testnet/contracts",
    "check:pump-subgraphs": "npm run check:pump-subgraph:testnet",
    "check:pump-subgraph:testnet": "npm --prefix 0xNothing-zkLTC-Testnet/subgraphs/0xpump run check",
    "build:pump-subgraph": "npm --prefix 0xNothing-zkLTC-Testnet/subgraphs/0xpump run build",
    "check:nusd-subgraph": "npm --prefix 0xNothing-zkLTC-Testnet/subgraphs/0xpixel-nusd-market run check",
    "check:fi:scripts": "npm --prefix 0xNothing-zkLTC-Testnet/0xFi run check:scripts",
    "check:fi": "npm --prefix 0xNothing-zkLTC-Testnet/0xFi run build",
    "audit:fi:report": "npm --prefix 0xNothing-zkLTC-Testnet/0xFi run audit:live:report",
    "verify": "npm run test:tooling && npm run test:web && npm run test:contracts && npm run check:nusd-subgraph && npm run check:pump-subgraphs && npm run check:fi && npm run verify:wallet"
  }
}

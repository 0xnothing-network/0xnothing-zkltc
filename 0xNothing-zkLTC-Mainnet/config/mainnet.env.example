# zkLTC mainnet deployment variables. Copy to a file outside Git (never commit the real one).

# Chain
MAINNET_CHAIN_ID=
MAINNET_RPC_URL=

# Deployer key, loaded only into the forge process
PRIVATE_KEY=

# Wrapped native zkLTC (deploy 0xFi/contracts/script/DeployWzkLTC.s.sol if none exists)
MAINNET_WZKLTC=

# DIA AggregatorV3 feeds; their description() must be exactly LTC/USD, BTC/USD, ETH/USD
MAINNET_DIA_LTC_USD=
MAINNET_DIA_BTC_USD=
MAINNET_DIA_ETH_USD=

# Filled from contracts/deployments/mainnet-core.json before the 0xFi script
MAINNET_NUSD=
MAINNET_PUMP=
MAINNET_PUMP_GRADUATION_ROUTER=
MAINNET_FEE_SPLITTER=
MAINNET_TREASURY=
MAINNET_LTC_ORACLE=
MAINNET_BTC_ORACLE=
MAINNET_ETH_ORACLE=

# Optional: ".rehearsal" for fork runs
MAINNET_MANIFEST_SUFFIX=

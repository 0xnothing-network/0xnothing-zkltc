# zkLTC mainnet deployment variables. Copy to a file outside Git (never commit the real one).

# Chain
MAINNET_CHAIN_ID=
MAINNET_RPC_URL=

# Deployer key, loaded only into the forge process. MAINNET_DEPLOYER is its address: the read-only
# verify() entry points use it instead of the key.
PRIVATE_KEY=
MAINNET_DEPLOYER=

# Wrapped native zkLTC (deploy 0xFi/contracts/script/DeployWzkLTC.s.sol if none exists). The core
# script refuses a token that does not have 18 decimals or does not mint and pay back 1:1 (it tries
# a deposit and a withdraw of one wei in its local simulation).
MAINNET_WZKLTC=

# DIA AggregatorV3 feeds; their description() must be exactly LTC/USD, BTC/USD, ETH/USD. The chain
# cannot tell whether an address is DIA's own feed: compare these three with DIA's published
# addresses by hand. The core manifest records them for a second person to check.
MAINNET_DIA_LTC_USD=
MAINNET_DIA_BTC_USD=
MAINNET_DIA_ETH_USD=

# Oracle-lag guards, from the feeds' published parameters. H is the heartbeat in seconds (use the
# longest of the three feeds: one adapter age serves all of them) and D is the deviation threshold
# of the LTC/USD feed in bps. The core script refuses values that break the rules marked "enforced".
#   MAINNET_FEED_HEARTBEAT_SECONDS      H itself, for the checks below.
#   MAINNET_FEED_DEVIATION_BPS          D itself, for the checks below. The chain cannot confirm
#                                       it; a value lower than the real one makes the fees too low.
#   MAINNET_MINT_MAX_PRICE_AGE_SECONDS  at least H (enforced): a calm market leaves a price up to H
#                                       old, and below H minting would stop and redemption would
#                                       pay the 2% maximum fee for part of every heartbeat.
#   MAINNET_ORACLE_MAX_AGE_SECONDS      at least the mint age (enforced); the adapter accepts
#                                       300-86400. A price older than this makes the oracle
#                                       unusable (no mint, no redeem). Keep it close to the mint
#                                       age: a redemption against a price between the two pays 2%,
#                                       and a larger move inside that gap can still be taken from
#                                       the surplus.
#   MAINNET_MINT_FEE_BPS / REDEEM       each at least D (enforced), at most 200. A trade against a
#                                       lagging price uses one leg, so D/2 per fee is not enough.
#   MAINNET_MINT_LIMIT_PER_HOUR_NUSD    whole NUSD, between 1 and 100,000, a tenth of the supply
#                                       ceiling (enforced). No more than this can be minted at once
#                                       and no more than twice this in any hour; it is what a wrong
#                                       price can cost.
# The script also refuses to deploy while a live price is within a factor of two of its adapter's
# bounds (LTC 10-1,000, BTC 5,000-500,000, ETH 250-50,000 USD): the bounds would no longer fit.
MAINNET_FEED_HEARTBEAT_SECONDS=
MAINNET_FEED_DEVIATION_BPS=
MAINNET_MINT_MAX_PRICE_AGE_SECONDS=
MAINNET_ORACLE_MAX_AGE_SECONDS=
MAINNET_MINT_FEE_BPS=
MAINNET_REDEEM_FEE_BPS=
MAINNET_MINT_LIMIT_PER_HOUR_NUSD=

# Filled from contracts/deployments/mainnet-core.json before the 0xFi script
MAINNET_NUSD=
MAINNET_PUMP=
MAINNET_PUMP_GRADUATION_ROUTER=
MAINNET_FEE_SPLITTER=
MAINNET_TREASURY=
MAINNET_LTC_ORACLE=
MAINNET_BTC_ORACLE=
MAINNET_ETH_ORACLE=

# Roles. Both are required and neither can be the zero address.
#   MAINNET_GOVERNANCE  long-term owner (a multisig). It becomes the governance of the Pump
#                       graduation controller, which can never be changed afterwards, the pending
#                       owner of the five 0xFi contracts that keep one (factory, gauge factory,
#                       both synth vaults, lending; the Safety Reserve is left without an owner),
#                       and, through the core script's handover(), the holder of every core role.
#                       It must already exist on this chain: a contract, or an account that has
#                       been funded (enforced). A funded account whose key is lost still passes,
#                       so check it by hand.
#   MAINNET_GUARDIAN    pause-only key of the controller, of the factory, gauge factory, Safety
#                       Reserve, both synth vaults and lending, and (after handover()) of NUSD
#                       minting. It can lift none of those pauses.
MAINNET_GOVERNANCE=
MAINNET_GUARDIAN=

# Filled from 0xFi/contracts/deployments/mainnet-fi.json before ActivateGraduationMainnet
MAINNET_PUMP_GRADUATION_ADAPTER=

# Optional; leave it unset otherwise. "true" makes verify() expect the final state: governance
# holds every role, nothing is pending, the deployer holds none, and graduation is active.
# MAINNET_VERIFY_HANDOVER=true

# Optional: ".rehearsal" for fork runs (those manifests are ignored by Git)
MAINNET_MANIFEST_SUFFIX=

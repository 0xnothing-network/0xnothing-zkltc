# zkLTC mainnet deployment variables. Copy to a file outside Git (never commit the real one).

# Chain
MAINNET_CHAIN_ID=
MAINNET_RPC_URL=

# Deployer key, loaded only into the forge process
PRIVATE_KEY=

# Wrapped native zkLTC (deploy 0xFi/contracts/script/DeployWzkLTC.s.sol if none exists)
MAINNET_WZKLTC=

# DIA AggregatorV3 feeds; their description() must be exactly LTC/USD, BTC/USD, ETH/USD
MAINNET_DIA_LTC_USD=
MAINNET_DIA_BTC_USD=
MAINNET_DIA_ETH_USD=

# Oracle-lag guards: set from the mainnet feed's heartbeat (H) and deviation threshold (D).
# Oracle age just above H (adapter accepts 300-86400 s), mint age <= oracle age,
# each fee >= D/2 in bps (max 200), hourly mint budget in whole NUSD.
MAINNET_ORACLE_MAX_AGE_SECONDS=
MAINNET_MINT_MAX_PRICE_AGE_SECONDS=
MAINNET_MINT_LIMIT_PER_HOUR_NUSD=
MAINNET_MINT_FEE_BPS=
MAINNET_REDEEM_FEE_BPS=

# Filled from contracts/deployments/mainnet-core.json before the 0xFi script
MAINNET_NUSD=
MAINNET_PUMP=
MAINNET_PUMP_GRADUATION_ROUTER=
MAINNET_FEE_SPLITTER=
MAINNET_TREASURY=
MAINNET_LTC_ORACLE=
MAINNET_BTC_ORACLE=
MAINNET_ETH_ORACLE=

# Optional: ".rehearsal" for fork runs
MAINNET_MANIFEST_SUFFIX=

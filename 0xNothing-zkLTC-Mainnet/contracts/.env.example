# LitVM mainnet. Copy to `.env` in this directory.
# Foundry loads `.env` automatically. Never commit a funded key or `.env`.

# Required even for a no-broadcast simulation: the script derives the deployer
# from this key. Generate a throwaway with `cast wallet new` for dry runs. For
# an approved broadcast, use a funded mainnet deployer that is not stored in git.
PRIVATE_KEY=

# Passed to `forge script --rpc-url`. Not read by the Solidity script.
# Alias: `forge script ... --rpc-url mainnet` after setting this.
MAINNET_RPC_URL=

# Required. Must match `block.chainid` of MAINNET_RPC_URL. Rejected values:
# 0, 4441 (LiteForge testnet), 31337 (local Anvil).
EXPECTED_MAINNET_CHAIN_ID=

# Required release gate. The script reverts unless this is exactly `true`.
MAINNET_RELEASE_APPROVED=false

# Optional. Defaults to the deployer address derived from PRIVATE_KEY.
# When this differs from the deployer, the admin must later call acceptAdmin()
# on ZeroXPump, GraduationRouter, and DIAOracleAdapter.
# Mainnet: this MUST be a Safe multisig behind a timelock, not a hot EOA.
PROTOCOL_ADMIN=

# Required oracle policy. No defaults — they depend on the final feed heartbeat.
# Units: seconds and 18-decimal USD (wad), except BPS.
# DIA_MAX_PRICE_AGE is clamped on-chain to 300..7200.
DIA_LTC_USD_FEED=
DIA_MAX_PRICE_AGE=3600
DIA_MIN_PRICE_WAD=1000000000000000000
DIA_MAX_PRICE_WAD=10000000000000000000000
DIA_MAX_DEVIATION_BPS=2000

# Optional. GraduationRouter minimumDelay in seconds (default 604800 = 7 days).
GRADUATION_TIMELOCK=604800

# Optional. Each Pump token's fixed total supply (default 1_000_000_000e18).
PUMP_TOKEN_TOTAL_SUPPLY=1000000000000000000000000000

# Optional anti-snipe. Cumulative gross NUSD per buyer during the window.
# Window 0 disables. Defaults: 15 minutes / 50 NUSD.
LAUNCH_PROTECTION_WINDOW=900
LAUNCH_MAX_BUY_NUSD=50000000000000000000

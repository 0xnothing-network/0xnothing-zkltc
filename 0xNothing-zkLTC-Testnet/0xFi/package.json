{
  "name": "0xfi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "subgraph"
  ],
  "scripts": {
    "rwa:test": "forge test --root contracts --match-contract RwaMarketTest",
    "rwa:check": "node --experimental-strip-types scripts/check-rwa-markets.mjs",
    "rwa:abi": "forge build --root contracts && node scripts/generate-rwa-abi.mjs",
    "dev": "npm --prefix ../apps/web run dev -- --port 3300",
    "build": "npm run check:scripts && npm run check:contracts && npm run check:subgraph && npm run check:web",
    "check:scripts": "node scripts/check-scripts.mjs && node --test scripts/test/*.test.mjs",
    "check:contracts": "forge test --root contracts && forge build --root contracts --sizes --skip script --skip test",
    "check:subgraph": "npm --workspace subgraph run check",
    "check:web": "npm --prefix ../apps/web run typecheck && npm --prefix ../apps/web run lint && npm --prefix ../apps/web run build",
    "deploy:v3:rehearse": "node scripts/deploy-v3.mjs --rehearse",
    "deploy:v3": "node scripts/deploy-v3.mjs --broadcast",
    "deploy:v3:activate": "node scripts/deploy-v3.mjs --activate",
    "deploy:v3:publish": "node scripts/deploy-v3.mjs --publish",
    "deploy:v3:status": "node scripts/deploy-v3.mjs --status"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "viem": "2.57.10"
  }
}

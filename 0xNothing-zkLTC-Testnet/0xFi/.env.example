# Never commit a funded key. DEPLOYER_PRIVATE_KEY may also be supplied as API_KEY
# in .env.local for compatibility with the current local wallet setup.
DEPLOYER_PRIVATE_KEY=
# Optional separate gas wallet for the permissionless graduation keeper.
KEEPER_PRIVATE_KEY=
GRADUATION_KEEPER_INTERVAL_SECONDS=20
GRADUATION_KEEPER_MAX_PER_SCAN=3
LITEFORGE_RPC_URL=https://liteforge.rpc.caldera.xyz/infra-partner-http
LITEFORGE_FALLBACK_RPC_URL=https://liteforge.rpc.caldera.xyz/http
NEXT_PUBLIC_RPC_URL=https://liteforge.rpc.caldera.xyz/infra-partner-http
NEXT_PUBLIC_GOLDSKY_ENDPOINT=
GOLDSKY_API_KEY=

# Existing protocol addresses, DIA feeds, exact feed descriptions, and oracle
# age bounds are pinned in config/liteforge-testnet.json and the Foundry deploy
# scripts. Environment variables cannot override those safety values.

# Conservative testnet launch limits. Debt ceilings are synth units (18 decimals).
NBTC_DEBT_CEILING=10000000000000000
NETH_DEBT_CEILING=250000000000000000
LENDING_SUPPLY_CAP_NUSD=5000000000000000000000
LENDING_BORROW_CAP_NUSD=2500000000000000000000
WZKLTC_COLLATERAL_CAP=50000000000000000000
NBTC_LENDING_COLLATERAL_CAP=10000000000000000
NETH_LENDING_COLLATERAL_CAP=250000000000000000

# LitVM LiteForge testnet (chain ID 4441). Copy to `.env` in this directory.
# Foundry loads `.env` automatically. Never commit a funded key or `.env`.

# Required even for a no-broadcast simulation: the script derives the deployer
# from this key. Generate a throwaway with `cast wallet new` for dry runs. For
# an approved broadcast, use a funded LiteForge deployer that is not stored in git.
PRIVATE_KEY=

# Passed to `forge script --rpc-url`. Not read by the Solidity script.
LITVM_RPC_URL=https://liteforge.rpc.caldera.xyz/infra-partner-http

# Optional. Defaults to the deployer address derived from PRIVATE_KEY.
# When this differs from the deployer, the admin must later call acceptAdmin()
# on ZeroXPump, GraduationRouter, and DIAOracleAdapter.
PROTOCOL_ADMIN=

# Optional oracle policy. Units: seconds and 18-decimal USD (wad), except BPS.
# DIA_MAX_PRICE_AGE is clamped on-chain to 300..7200. The live LiteForge DIA
# LTC/USD feed publishes about every 50 minutes, so values below 3600 halt mint
# and redeem between updates. DIA_MAX_DEVIATION_BPS must be 1..10000 (0 rejected).
DIA_LTC_USD_FEED=0x45dDa5d881BD2C917976CCfde74fFd6f6412da29
DIA_MAX_PRICE_AGE=3600
DIA_MIN_PRICE_WAD=1000000000000000000
DIA_MAX_PRICE_WAD=10000000000000000000000
DIA_MAX_DEVIATION_BPS=2000

# Optional. GraduationRouter minimumDelay in seconds (default 172800 = 2 days).
GRADUATION_TIMELOCK=172800

# Optional. Each Pump token's fixed total supply (default 1_000_000_000e18).
PUMP_TOKEN_TOTAL_SUPPLY=1000000000000000000000000000

# Optional. OracleNUSD.supplyCeilingNusd (default 1_000_000e18). Name kept for
# compatibility; this is not a vault debt ceiling.
NUSD_DEBT_CEILING=1000000000000000000000000

# Optional anti-snipe. Cumulative gross NUSD per buyer during the window.
# Window 0 disables. Defaults: 15 minutes / 50 NUSD.
LAUNCH_PROTECTION_WINDOW=900
LAUNCH_MAX_BUY_NUSD=50000000000000000000

# Optional Pump curve thresholds. Defaults keep the reviewed 1,500 / 6,000 NUSD
# pair. Testnet-only usability example: 50 NUSD virtual reserve / 200 NUSD READY
# market cap (derived real-reserve target is then 50 NUSD). Mainnet constants
# stay hardcoded at 1,500 / 6,000.
PUMP_INITIAL_VIRTUAL_NUSD=1500000000000000000000
PUMP_GRADUATION_MARKET_CAP_NUSD=6000000000000000000000
# Optional. If set, must equal sqrtUp(virtual * marketCap) - virtual.
# PUMP_GRADUATION_RESERVE_NUSD=1500000000000000000000

# Optional TestnetFaucet (script/DeployFaucet.s.sol). Defaults: 0.05 zkLTC /
# 25 NUSD every 8 hours, with 2 zkLTC and 1,000 NUSD daily caps.
# NUSD_ADDRESS=0x677D63c78E77E0b1971530e1494Caee4Bd7d631e
FAUCET_NATIVE_DRIP=50000000000000000
FAUCET_NUSD_DRIP=25000000000000000000
FAUCET_COOLDOWN=28800
FAUCET_DAILY_NATIVE_CAP=2000000000000000000
FAUCET_DAILY_NUSD_CAP=1000000000000000000000

{
  "name": "0xnothing-zkltc-testnet-wallet",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "0xNothing zkLTC testnet wallet — MV3 browser extension and Capacitor Android, sharing one React UI.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-all.mjs",
    "build:app": "vite build",
    "build:inject": "node scripts/build-inject.mjs",
    "build:android": "node scripts/build-all.mjs && cap sync android",
    "android:configure": "node --experimental-strip-types scripts/configure-android.ts",
    "capacitor:sync:after": "node --experimental-strip-types scripts/configure-android.ts",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@types/qrcode": "1.5.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.10"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@types/chrome": "0.3.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}

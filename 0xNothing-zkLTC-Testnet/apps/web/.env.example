# LitVM Testnet / 0xPump public runtime configuration.
NEXT_PUBLIC_PUMP_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_NUSD_ADDRESS=0x0000000000000000000000000000000000000000
# Testnet graduation migration is disabled; keep the DEX placeholder unset.
NEXT_PUBLIC_PUMP_DEX_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_PUMP_START_BLOCK=0
NEXT_PUBLIC_PUMP_SUBGRAPH_URL=
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Server-only. Never expose this as NEXT_PUBLIC_PINATA_JWT.
PINATA_JWT=

# Optional fixed host used in wallet-signed IPFS upload messages.
# Example: testnet.0xnothing.net
UPLOAD_SIGNING_DOMAIN=

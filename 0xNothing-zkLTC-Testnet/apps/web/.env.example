# Contract addresses, RPC, subgraphs and the IPFS gateway are versioned in
# lib/publicConfig.ts and features/fi/config/testnet.generated.json. A Vercel
# deployment needs only PINATA_JWT and UPLOAD_SIGNING_DOMAIN.

# Server-only. Never expose this as NEXT_PUBLIC_PINATA_JWT.
PINATA_JWT=

# Public host(s) users open the app on; wallet-signed IPFS uploads must name one.
# Required in production. Comma-separate several: 0xnothing.xyz,www.0xnothing.xyz
UPLOAD_SIGNING_DOMAIN=

# Keep false. When true, NEXT_PUBLIC_*_ADDRESS, NEXT_PUBLIC_GOLDSKY_ENDPOINT and
# NEXT_PUBLIC_DEPLOYMENT_BLOCK override the generated deployment (see
# features/fi/config/deployment.ts).
NEXT_PUBLIC_ALLOW_DEPLOYMENT_OVERRIDES=false

# Optional overrides; empty values use the versioned deployment.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_PIXEL_NUSD_MARKETPLACE_ADDRESS=
# Server-only override of the subgraphs/0xpixel-nusd-market endpoint.
PIXEL_NUSD_SUBGRAPH_URL=

# Cloudflare + Railway only (docs/CLOUDFLARE_RAILWAY.md); leave empty on Vercel.
# The proxy secret must match x-0xnothing-proxy-secret; with it set, requests
# without that header are rejected.
TRUSTED_PROXY_SHARED_SECRET=
UPLOAD_TRUSTED_PROXY_CLIENT_IP_HEADER=
FI_TRUSTED_PROXY_CLIENT_IP_HEADER=

# Set by wrangler.jsonc for a direct Cloudflare Worker deployment.
CLOUDFLARE_WORKERS=false

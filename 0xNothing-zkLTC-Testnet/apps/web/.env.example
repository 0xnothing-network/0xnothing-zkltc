# Testnet contracts, subgraph, and the public IPFS gateway are versioned in
# lib/publicConfig.ts and do not require Vercel environment variables.

# Server-only. Never expose this as NEXT_PUBLIC_PINATA_JWT.
PINATA_JWT=

# NUSD staking / xPoints. Keep the signer key server-only and use a dedicated,
# unfunded wallet that is never reused as the deployer or protocol owner.
POINTS_SIGNER_PRIVATE_KEY=
POINTS_STAKING_ADDRESS=
POINTS_SIGNING_DOMAIN=127.0.0.1:3300
POINTS_TRUSTED_PROXY_CLIENT_IP_HEADER=

# 0xFi is compiled into this app. Its public testnet configuration is versioned
# in features/fi/config/deployment.ts; NEXT_PUBLIC_* variables can override it.
# Overrides are ignored unless this explicit safety gate is enabled.
NEXT_PUBLIC_ALLOW_DEPLOYMENT_OVERRIDES=false

# Fixed host used in wallet-signed IPFS upload messages; required in production.
# Example: 0xnothing.xyz
UPLOAD_SIGNING_DOMAIN=

# Optional proxy header that the deployment overwrites with the real client IP.
# Cloudflare + Railway: set both values below to cf-connecting-ip and configure
# TRUSTED_PROXY_SHARED_SECRET plus the request-header Transform Rule documented
# in docs/CLOUDFLARE_RAILWAY.md. Otherwise leave them empty.
UPLOAD_TRUSTED_PROXY_CLIENT_IP_HEADER=

# Same idea for the 0xFi token-metadata route.
FI_TRUSTED_PROXY_CLIENT_IP_HEADER=

# Server-only. Must match the x-0xnothing-proxy-secret value injected by the
# trusted reverse proxy. Generate at least 32 random bytes; never use NEXT_PUBLIC_.
TRUSTED_PROXY_SHARED_SECRET=

# Set by wrangler.jsonc for a direct Cloudflare Worker deployment. This trusts
# Cloudflare's own cf-connecting-ip header without enabling a public origin.
CLOUDFLARE_WORKERS=false

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3300/0xFi
NEXT_PUBLIC_LITVM_RPC_URL=https://liteforge.rpc.caldera.xyz/infra-partner-http
NEXT_PUBLIC_LITVM_EXPLORER_URL=https://liteforge.explorer.caldera.xyz
NEXT_PUBLIC_GOLDSKY_ENDPOINT=https://api.goldsky.com/api/public/project_cms8vgtcn6a6z01r5fo87d6im/subgraphs/zeroxfi-testnet/staging/gn
NEXT_PUBLIC_DEPLOYMENT_BLOCK=35303686

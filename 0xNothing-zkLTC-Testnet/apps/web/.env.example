# Testnet contracts, subgraph, and the public IPFS gateway are versioned in
# lib/publicConfig.ts and do not require Vercel environment variables.

# Server-only. Never expose this as NEXT_PUBLIC_PINATA_JWT.
PINATA_JWT=

# Public origin of the separate 0xFi Next.js deployment. Required on Vercel.
# Example: https://zeroxfi-testnet.vercel.app
OXFI_PUBLIC_ORIGIN=

# Local two-server fallback. Do not set this to localhost on Vercel.
OXFI_INTERNAL_ORIGIN=http://127.0.0.1:3301

# Optional fixed host used in wallet-signed IPFS upload messages.
# Example: testnet.0xnothing.net
UPLOAD_SIGNING_DOMAIN=

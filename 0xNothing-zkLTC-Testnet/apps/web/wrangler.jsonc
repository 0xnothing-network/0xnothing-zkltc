{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "0xnothing-zkltc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  // The custom domains are the only public hosts: a workers.dev twin skips the zone's
  // WAF, rate limits and cache, and cannot sign uploads (UPLOAD_SIGNING_DOMAIN).
  // Every host listed here must also be listed in UPLOAD_SIGNING_DOMAIN below.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "0xnothing.app",
      "custom_domain": true
    },
    {
      "pattern": "0xnothing.network",
      "custom_domain": true
    },
    {
      "pattern": "www.0xnothing.network",
      "custom_domain": true
    }
  ],
  // Workers Cache: Cloudflare answers from its edge cache before the Worker runs, by
  // the Cache-Control each response already carries (Cloudflare-CDN-Cache-Control
  // first, see lib/server/cdnCache.ts). Without it every isolate started cold and paid
  // the full subgraph and RPC load itself. A deployment starts from an empty cache,
  // since the Worker version is part of the key. With this on, static asset requests
  // count as Worker requests on the bill.
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CLOUDFLARE_WORKERS": "true",
    "UPLOAD_SIGNING_DOMAIN": "0xnothing.app,0xnothing.network,www.0xnothing.network",
    "UPLOAD_TRUSTED_PROXY_CLIENT_IP_HEADER": "cf-connecting-ip",
    "FI_TRUSTED_PROXY_CLIENT_IP_HEADER": "cf-connecting-ip"
  },
  "observability": {
    "enabled": true
  }
}

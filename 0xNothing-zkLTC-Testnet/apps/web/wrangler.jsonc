{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "0xnothing-zkltc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  // The custom domain is the only public host: a workers.dev twin skips the zone's
  // WAF, rate limits and cache, and cannot sign uploads (UPLOAD_SIGNING_DOMAIN).
  "workers_dev": false,
  "routes": [
    {
      "pattern": "0xnothing.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CLOUDFLARE_WORKERS": "true",
    "UPLOAD_SIGNING_DOMAIN": "0xnothing.app",
    "UPLOAD_TRUSTED_PROXY_CLIENT_IP_HEADER": "cf-connecting-ip",
    "FI_TRUSTED_PROXY_CLIENT_IP_HEADER": "cf-connecting-ip"
  },
  "observability": {
    "enabled": true
  }
}

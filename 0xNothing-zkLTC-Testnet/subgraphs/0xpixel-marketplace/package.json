{
  "name": "marketplace-subgraph",
  "version": "1.0.0",
  "private": true,
  "description": "0xPIXEL marketplace subgraph for LiteForge",
  "scripts": {
    "codegen": "graph codegen",
    "build": "npm run codegen && graph build",
    "check": "npm run build",
    "deploy": "npx goldsky subgraph deploy marketplace/1.0.1 --path .",
    "create-local": "graph create --node http://127.0.0.1:8020 marketplace-subgraph",
    "remove-local": "graph remove --node http://127.0.0.1:8020 marketplace-subgraph",
    "deploy-local": "graph deploy --node http://127.0.0.1:8020 --ipfs http://127.0.0.1:5001 marketplace-subgraph"
  },
  "dependencies": {
    "@graphprotocol/graph-ts": "0.38.2"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1"
  }
}
